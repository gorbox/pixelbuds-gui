[Unit]
Description=Pixel Buds monitor (pbwatch)
After=bluetooth.target
Wants=bluetooth.target

[Service]
# Installed by pbutils/install.sh. The installer replaces YOUR_MAC_HERE with the
# detected Pixel Buds MAC and leaves the %h (home) specifiers for systemd to expand.
# Customise later via:  systemctl --user edit pbwatch
# Add --heal-audio if audio doesn't route automatically when the buds connect.
ExecStart=%h/.local/bin/pbwatch --mac YOUR_MAC_HERE --on-update %h/.local/bin/pbwidget --on-disconnect "%h/.local/bin/pbwidget --disconnected"
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
